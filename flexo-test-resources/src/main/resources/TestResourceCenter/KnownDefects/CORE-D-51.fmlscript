// CORE-D-51: the initializer and the cardinality written in a property declaration must reach the model.
virtualModel = load -r ["http://openflexo.org/test/TestResourceCenter/KDPropertyInit.fml"];
holder = virtualModel.getFlexoConcept("Holder");
assert holder.getAccessibleProperty("objects").cardinality.toString() == "ZeroMany";
assert holder.getAccessibleProperty("first").defaultValue.isSet();
service ResourceCenterService add_temp_rc;
vmi = new KDPropertyInit() with (name="kd51");
p = vmi.new Person();
h = vmi.new Holder();
assert h.selected == p;
