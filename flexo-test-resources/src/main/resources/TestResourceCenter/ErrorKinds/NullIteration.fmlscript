// CORE-F-11: iterating over null is an error (FMLNullReferenceError), no longer zero iterations.
virtualModel = load -r ["http://openflexo.org/test/TestResourceCenter/ExecutionFailures.fml"];
service ResourceCenterService add_temp_rc;
vmi = new ExecutionFailures() with (name="nulliteration");
mustFail = vmi.nullIteration();
