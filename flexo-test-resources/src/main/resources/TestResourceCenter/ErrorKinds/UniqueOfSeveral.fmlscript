// CORE-F-11 phase 6: a select unique that finds several results is an error (FMLCardinalityError), no longer its first result.
virtualModel = load -r ["http://openflexo.org/test/TestResourceCenter/ExecutionFailures.fml"];
service ResourceCenterService add_temp_rc;
vmi = new ExecutionFailures() with (name="unique");
mustFail = vmi.uniqueOfSeveral();
