// CORE-F-11: && and || are lazy: a null check guards the right operand, nothing fails.
virtualModel = load -r ["http://openflexo.org/test/TestResourceCenter/ExecutionFailures.fml"];
service ResourceCenterService add_temp_rc;
vmi = new ExecutionFailures() with (name="shortcircuit");
assert vmi.guardedByAnd() == false;
assert vmi.guardedByOr() == true;
