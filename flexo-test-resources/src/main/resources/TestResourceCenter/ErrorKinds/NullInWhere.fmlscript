// CORE-F-11: a null in the path of a where condition is an error (FMLNullReferenceError), no longer a candidate left out.
virtualModel = load -r ["http://openflexo.org/test/TestResourceCenter/ExecutionFailures.fml"];
service ResourceCenterService add_temp_rc;
vmi = new ExecutionFailures() with (name="where");
mustFail = vmi.nullInWhere();
