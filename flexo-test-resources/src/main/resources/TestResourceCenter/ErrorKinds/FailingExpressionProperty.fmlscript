// CORE-F-11: a failing expression property fails its reader (FMLNullReferenceError).
virtualModel = load -r ["http://openflexo.org/test/TestResourceCenter/ExecutionFailures.fml"];
service ResourceCenterService add_temp_rc;
vmi = new ExecutionFailures() with (name="expression");
mustFail = vmi.readFailingExpression();
