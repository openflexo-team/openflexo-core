// CORE-F-11: a failing getter, read through this., fails its reader (FMLNullReferenceError, frame of the getter).
virtualModel = load -r ["http://openflexo.org/test/TestResourceCenter/ExecutionFailures.fml"];
service ResourceCenterService add_temp_rc;
vmi = new ExecutionFailures() with (name="getterthis");
mustFail = vmi.readFailingGetterThroughThis();
