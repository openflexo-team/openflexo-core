// A fetch request whose container cannot be resolved names its unresolved container, it does not blow up.
//
// Regression test for a defect found while making a serialized instance reload:
// "select X from <null>" threw a raw NullPointerException straight out of the engine, whose stack trace never named the
// unresolved container. It then gave an empty result. Since CORE-F-11 phase 6 it is an FMLNullReferenceError naming the
// select: "select Item from parameters.container: no virtual model instance to select from". A script cannot catch it
// (FML try/catch comes with phase 7): the failing case is asserted by TestFMLErrorKinds.selectFromNullModel.

virtualModel = load -r ["http://openflexo.org/test/TestResourceCenter/TestFetchFromNullContainer.fml"];
assert virtualModel != null;

service ResourceCenterService add_temp_rc;
myVMI = new TestFetchFromNullContainer() with (name="testFetchFromNullContainer");
assert myVMI != null;

myVMI.newItem("a");
myVMI.newItem("b");

// Selecting from a resolved container finds both instances.
assert myVMI.selectItemsFrom(myVMI).size == 2;

log "Test PASSED: a fetch from a resolved container finds its instances";
