service ResourceCenterService status;
resources;
context;
virtualModel = load -r ["http://openflexo.org/test/TestResourceCenter/TestDefaultValue.fml"];
context;
assert virtualModel != null;
log "Pretty-print of "+virtualModel;
log virtualModel.fMLPrettyPrint;
//validate virtualModel;
service ResourceCenterService add_temp_rc;
myVMI = new TestDefaultValue() with (name="MyTestDefaultValue");
context;
assert myVMI != null;
foo = myVMI.new Foo();
assert foo.anInteger == 2;
assert foo.aName == "Hello!";
assert foo.aList != null;
foo.addAValue();
assert foo.aList.size == 1;
