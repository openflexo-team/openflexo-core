service ResourceCenterService status;
resources;
context;
virtualModel = load -r ["http://openflexo.org/test/TestResourceCenter/RootedTree.fml"];
context;
assert virtualModel != null;
log "Pretty-print of "+virtualModel;
log virtualModel.fMLPrettyPrint;
//validate virtualModel;
service ResourceCenterService add_temp_rc;
myTree = new RootedTree() with (name="TestRootedTree");
context;
assert myTree != null;
a = myTree.new Vertex("A");
b = myTree.new Vertex("B");
c = myTree.new Vertex("C");
ab = myTree.new Edge(a,b);
bc = myTree.new Edge(b,c);
b1 = myTree.new Vertex("B1");
b2 = myTree.new Vertex("B2");
bb1 = myTree.new Edge(b,b1);
bb2 = myTree.new Edge(b,b2);
myTree.addToRoots(a);
result = myTree.breadthFirstTraversalDoFlat();
log "result: "+result;
assert result.size() == 5;
assert result.contains(a);
assert result.contains(b);
assert result.contains(c);
assert result.contains(b1);
assert result.contains(b2);
