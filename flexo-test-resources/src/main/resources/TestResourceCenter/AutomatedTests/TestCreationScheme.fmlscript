service ResourceCenterService status;
resources;
context;
virtualModel = load -r ["http://openflexo.org/test/TestResourceCenter/TestCreationScheme.fml"];
context;
assert virtualModel != null;
log "Pretty-print of "+virtualModel;
log virtualModel.fMLPrettyPrint;
//validate virtualModel;
service ResourceCenterService add_temp_rc;
myVMI = new TestCreationScheme() with (name="test1");
context;
assert myVMI != null;
foo1 = myVMI.testInstanciateFoo1();
assert foo1 != null;
assert foo1.name == "Foo1";
foo2 = myVMI.testInstanciateFoo2();
assert foo2 != null;
assert foo2.name == "Foo2";
foo3 = myVMI.testInstanciateFoo3();
assert foo3 != null;
assert foo3.name == "Foo3withConstructor1";
foo1b = myVMI.testMatchFoo1();
assert foo1b != null;
assert foo1b.name == "Foo1";
foo2b = myVMI.testMatchFoo2();
assert foo2b != null;
assert foo2b.name == "Foo2";
foo3b = myVMI.testMatchFoo3();
assert foo3b != null;
assert foo3b.name == "Foo3withConstructor2";
foo2c = myVMI.testMatchFoo2Again();
assert foo2c.conceptType.name == "Foo2";

