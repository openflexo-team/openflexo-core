// CORE-F-11 phase 7: a caught FML exception thrown again keeps the FML stack of its first throw (asserted by TestFMLExceptions).
virtualModel = load -r ["http://openflexo.org/test/TestResourceCenter/Exceptions.fml"];
service ResourceCenterService add_temp_rc;
vmi = new Exceptions() with (name="rethrow");
mustFail = vmi.rethrow();
assert vmi.trace == "caught";
