// CORE-F-11 phase 7: the failure of a listener declaring an exception fails the fire, and the caller catches it.
virtualModel = load -r ["http://openflexo.org/test/TestResourceCenter/Exceptions.fml"];
service ResourceCenterService add_temp_rc;
vmi = new Exceptions() with (name="fire");
assert vmi.fireCaught() == "heard";
