// CORE-F-11 phase 7: the finally block runs when the error goes on.
virtualModel = load -r ["http://openflexo.org/test/TestResourceCenter/Exceptions.fml"];
service ResourceCenterService add_temp_rc;
vmi = new Exceptions() with (name="finally");
mustFail = vmi.finallyOnError();
assert vmi.cleaned == true;
