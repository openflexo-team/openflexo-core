// CORE-F-11 phase 7: a caught built-in error thrown again is the same error (asserted by TestFMLExceptions).
virtualModel = load -r ["http://openflexo.org/test/TestResourceCenter/Exceptions.fml"];
service ResourceCenterService add_temp_rc;
vmi = new Exceptions() with (name="rethrowbuiltin");
mustFail = vmi.rethrowBuiltIn();
