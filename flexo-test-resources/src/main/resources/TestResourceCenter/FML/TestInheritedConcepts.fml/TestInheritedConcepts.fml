/**
 * A model EXTENDING another must be able to instantiate the concepts it inherits.
 *
 * Regression fixture for two inverted guards in FMLRTVirtualModelInstanceModelFactory
 * .makeNewFlexoConceptInstance. isAssignableFrom(x) walks x's parents, so A.isAssignableFrom(B)
 * means "B is an A"; both guards had receiver and argument the wrong way round:
 *
 *   1. the DECLARING compilation unit check rejected every concept inherited from an extended
 *      VirtualModel (the declaring model is the ancestor, not the descendant);
 *   2. the CONTAINER check rejected a container that specializes the required one.
 *
 * A concept extending a nested one is declared in the container of its parent, or in a subtype of it (a root
 * declaration is a validation error, CORE-D-95), so the inherited-container case no longer occurs through a
 * declaration. The container check is still exercised: Item requires a Box and is given a SpecializedBox, a
 * subtype (the inverted check rejected exactly that), and SpecializedItem, declared in SpecializedBox, requires a
 * SpecializedBox.
 *
 * Both failures were SILENT: the FMLExecutionException is swallowed upstream and the factory simply
 * returned null. See TestInheritedConcepts.fmlscript.
 */

import ["http://openflexo.org/test/TestResourceCenter/TestBaseModelForInheritance.fml"];

@URI("http://openflexo.org/test/TestResourceCenter/TestInheritedConcepts.fml")
public model TestInheritedConcepts extends TestBaseModelForInheritance {

	public SpecializedBox newSpecializedBox(String name) {
		return new SpecializedBox(name);
	}

	public SpecializedItem newSpecializedItem(SpecializedBox box, String name) {
		return box.new SpecializedItem(name);
	}

	/** Specializes the container of the base model's Item, so that it can contain a specialization of Item. */
	public concept SpecializedBox extends Box {

		create(String name) {
			super(name);
		}

		delete() {
		}

		/** Declared in a subtype of Box, the container of its parent Item. */
		public concept SpecializedItem extends Item {

			String extra;

			create(String name) {
				super(name);
			}

			delete() {
			}
		}
	}
}
