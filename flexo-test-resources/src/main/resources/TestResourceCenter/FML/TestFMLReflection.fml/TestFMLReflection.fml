use org.openflexo.foundation.fml.rt.FMLRTModelSlot as FMLRT;

import java.lang.String;

@URI("http://openflexo.org/test/TestResourceCenter/TestFMLReflection.fml")
model TestFMLReflection {
	
	Concept<TestFMLReflection> vmConcept = this.conceptType;
	Foo existingFoo;
	Foo aFoo;
	Concept<Foo> fooConcept = aFoo.conceptType;

	create() {
		existingFoo = new Foo();
		fooConcept = existingFoo.conceptType;
	}
	
	test() {
		aFoo = FMLRT::NewInstance(conceptType=fooConcept, container=this);
	}

	Foo test2(String aString) {
		List<?> arguments = new ArrayList();
		arguments.add(aString);
		return FMLRT::NewInstance(conceptType=fooConcept, container=this, args=arguments);
	}

	// FMLRT::NewInstance inside a creation scheme leaves that scheme on its own instance (CORE-D-84)
	Holder test3() {
		return new Holder(this);
	}

	concept Holder {
		Foo inner;
		String tag;
		create(TestFMLReflection vm) {
			inner = FMLRT::NewInstance(conceptType=vm.fooConcept, container=vm);
			tag = "set";
		}
	}

	// Each creation makes one instance, its creation scheme run once (CORE-D-84)
	int fooCount() {
		int n = 0;
		for (Foo f : select Foo from this) {
			n = n + 1;
		}
		return n;
	}

	concept Foo {
		String name;
		
		create() {
		}
		create(String name) {
			log "Creating Foo with "+name;
			this.name = name;
		}
	}

}
