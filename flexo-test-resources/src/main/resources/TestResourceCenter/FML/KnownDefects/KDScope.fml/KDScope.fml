/**
 * CORE-D-48: a local variable outlives its block and hides a property. See KnownDefects/CORE-D-48.fmlscript.
 */
@URI("http://openflexo.org/test/TestResourceCenter/KDScope.fml")
public model KDScope {

	String name;

	create() {
		name = "property";
	}

	public String blockScope() {
		if (true) {
			String name = "local";
		}
		return name;
	}
}
