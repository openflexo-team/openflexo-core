<?xml version="1.0" encoding="UTF-8"?>
<!-- Fixture of the additive inspector inheritance: see TestContainerUI.fml, concept InspRight. -->
<Panel className="org.openflexo.gina.utils.FIBInspector" layout="twocols" name="InspRightInspector"
	dataClassName="org.openflexo.foundation.fml.rt.FlexoConceptInstance"
	controllerClassName="org.openflexo.inspector.FIBInspectorController">
	<TabPanel name="Tab">
		<Tab title="InspRight" layout="twocols" index="0" name="InspRightInspectorTab">
			<Label label="rightName" name="rightNameLabel"
				constraints="twocols(expandHorizontally=false;expandVertically=false;location=left;index=-1)" />
			<TextField data="data.rightName" name="rightNameWidget"
				constraints="twocols(expandHorizontally=true;expandVertically=false;location=right;index=-1)" />
		</Tab>
	</TabPanel>
</Panel>
