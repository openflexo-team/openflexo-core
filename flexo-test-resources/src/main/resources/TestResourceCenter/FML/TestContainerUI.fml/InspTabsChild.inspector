<?xml version="1.0" encoding="UTF-8"?>
<!-- Fixture of the additive inspector inheritance with NAMED tabs: see TestContainerUI.fml, concept InspTabsChild. -->
<Panel className="org.openflexo.gina.utils.FIBInspector" layout="twocols" name="InspTabsChildInspector"
	dataClassName="org.openflexo.foundation.fml.rt.FlexoConceptInstance"
	controllerClassName="org.openflexo.inspector.FIBInspectorController">
	<TabPanel name="Tab">
		<Tab title="Single (child)" layout="twocols" index="0" name="Single">
			<Label label="singleChild" name="singleChildLabel"
				constraints="twocols(expandHorizontally=false;expandVertically=false;location=left;index=2)" />
			<TextField data="data.singleChild" name="singleChildWidget"
				constraints="twocols(expandHorizontally=true;expandVertically=false;location=right;index=2)" />
		</Tab>
		<Tab title="Advanced" layout="twocols" index="0" name="Advanced">
			<Label label="advancedChild" name="advancedChildLabel"
				constraints="twocols(expandHorizontally=false;expandVertically=false;location=left;index=2)" />
			<TextField data="data.advancedChild" name="advancedChildWidget"
				constraints="twocols(expandHorizontally=true;expandVertically=false;location=right;index=2)" />
		</Tab>
		<Tab title="Extra" layout="twocols" index="0" name="Extra">
			<Label label="extraChild" name="extraChildLabel"
				constraints="twocols(expandHorizontally=false;expandVertically=false;location=left;index=1)" />
			<TextField data="data.extraChild" name="extraChildWidget"
				constraints="twocols(expandHorizontally=true;expandVertically=false;location=right;index=1)" />
		</Tab>
	</TabPanel>
</Panel>
