/**
 * Invalid uses of exceptions, throw and catch (CORE-F-11 phase 7): one issue per behaviour, asserted by TestExceptionsValidation
 */
@URI("http://openflexo.org/test/TestResourceCenter/InvalidExceptions.fml")
public model InvalidExceptions {

	String trace;

	public catchInternalError() {
		try {
			trace = "a";
		} catch (FMLInternalError e) {
			trace = "b";
		}
	}

	public catchCancellation() {
		try {
			trace = "a";
		} catch (FMLCancellation e) {
			trace = "b";
		}
	}

	public catchString() {
		try {
			trace = "a";
		} catch (String e) {
			trace = "b";
		}
	}

	public throwString() {
		throw "not an exception";
	}

	public unreachableClause() {
		try {
			trace = "a";
		} catch (FMLError e) {
			trace = "b";
		} catch (FMLTypeError e) {
			trace = "c";
		}
	}

	public variableOutsideItsBlock() {
		try {
			trace = "a";
		} catch (FMLError e) {
			trace = "b";
		}
		trace = e.message;
	}

	public redeclaredVariable() {
		String e = "x";
		try {
			trace = "a";
		} catch (FMLError e) {
			trace = "b";
		}
	}

	public unhandledThrow() {
		throw new Failure();
	}

	public declaresFailure() throws Failure {
		throw new Failure();
	}

	public unhandledCall() {
		this.declaresFailure();
	}

	public catchesTheWrongType() {
		try {
			this.declaresFailure();
		} catch (FMLTypeError e) {
			trace = "c";
		}
	}

	public makeRisky() {
		Risky r = new Risky();
	}

	public fireUnhandled() {
		fire new Ping();
	}

	public declaresOnlyFMLError() throws FMLError {
		throw new Failure();
	}

	public throwsAnUnresolvedType() throws NoSuchException {
		trace = "x";
	}

	public throwsNotAnException() throws String {
		trace = "x";
	}

	String computed values this.declaresFailure();

	listen Ping from this throws Failure {
		throw new Failure();
	}

	event Ping {
		create() {
		}
	}

	concept Risky {
		create() throws Failure {
			throw new Failure();
		}
	}

	concept Base {
		public step() {
		}
	}

	concept Derived extends Base {
		public step() throws Failure {
			throw new Failure();
		}
	}

	exception Failure {
	}

	concept Plain {
	}

	exception BadException extends Plain {
	}

	concept BadConcept extends Failure {
	}
}
