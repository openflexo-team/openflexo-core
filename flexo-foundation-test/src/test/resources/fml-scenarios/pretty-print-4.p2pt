--- source
use org.openflexo.foundation.fml.rt.FMLRTModelSlot as FMLRT;

import ["http://openflexo.org/test/TestResourceCenter/MyVM.fml"];

@URI("http://openflexo.org/test/TestResourceCenter/TestViewPointA.fml")
@Version("0.1")
model TestViewPointA {
	MyVM myModel with ModelInstance(isRequired=true,isReadOnly=false);

	create(required MyVM aModel, boolean aFlag) {
		myModel = parameters.aModel;
	}
}
